    risk_text = (row("positions", positions)
                 + row("resting orders", orders)
                 + row("trades today", fills_today)
                 + row("trades lifetime", "{:,}".format(fills_all))
                 + "\n"
                 + "loss stop {}  {}/{}\n".format(
                     meter(session_loss, session_cap),
                     plain(session_loss), plain(session_cap))
                 + "remaining {}  {}\n".format(
                     meter(session_cap - session_loss, session_cap),
                     plain(session_cap - session_loss)))
